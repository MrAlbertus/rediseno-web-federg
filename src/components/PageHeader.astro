---
/**
 * Header for inner pages: the same Nav as the hero, then a rounded navy
 * card with the page title (same radius, easing and entrance animation).
 */
import Nav from './Nav.astro';
import Stars from './Stars.astro';

interface Props {
  title: string;
  eyebrow?: string;
  lead?: string;
}

const { title, eyebrow, lead } = Astro.props;
// Optional meta line (dates, tags…) passed as children; skip the wrapper when empty
const meta = (await Astro.slots.render('default')).trim();
---

<header class="page-header">
  <div class="page-header__bar">
    <Nav />
  </div>

  <div class="page-header__card anim" style="--d:0">
    <Stars size="clamp(320px, 42vw, 620px)" x="88%" y="50%" opacity={0.4} />
    <div class="page-header__content">
      {eyebrow && <p class="eyebrow eyebrow--light anim" style="--d:2">{eyebrow}</p>}
      <h1 class="page-header__title anim" style="--d:3" data-pagefind-meta="title">{title}</h1>
      {lead && <p class="page-header__lead anim" style="--d:4">{lead}</p>}
      {meta && <div class="page-header__meta anim" style="--d:5" set:html={meta} />}
    </div>
  </div>
</header>

<style>
  .page-header {
    padding: var(--pad);
    padding-left: max(var(--pad), env(safe-area-inset-left));
    padding-right: max(var(--pad), env(safe-area-inset-right));
    /* The card slides in from the right (media-in); clip so it never adds a horizontal
       scrollbar. `clip` (unlike `hidden`) creates no scroll container or stacking context. */
    overflow-x: clip;
  }
  /* Same inset as .hero__left so the logo sits where it does on the home page */
  .page-header__bar { padding-left: clamp(4px, 1.6vw, 28px); }

  .page-header__card {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    margin-top: clamp(18px, 2.4vw, 32px);
    padding: clamp(48px, 7vw, 110px) clamp(24px, 5vw, 72px);
    border-radius: var(--radius-card);
    background:
      radial-gradient(60% 80% at 100% 100%, rgba(255, 100, 0, 0.35), transparent 70%),
      radial-gradient(70% 90% at 0% 0%, rgba(35, 62, 144, 0.95), transparent 70%),
      linear-gradient(160deg, #27275c 0%, #1f1f3f 58%, #16162e 100%);
    color: #fff;
  }
  .page-header__card.anim { animation-name: media-in; animation-duration: 1.05s; }

  .page-header__content {
    position: relative;
    max-width: 820px;
  }
  .page-header__title {
    margin: 0;
    /* Small minimum so long single words ("Representations") fit a 320px phone */
    font-size: clamp(1.75rem, 5vw, 4.2rem);
    font-weight: 600;
    letter-spacing: -0.025em;
    line-height: 1.08;
    text-wrap: balance;
    overflow-wrap: break-word;
    hyphens: auto;
  }
  .page-header__lead {
    max-width: 58ch;
    margin: clamp(18px, 2.4vw, 28px) 0 0;
    color: rgba(255, 255, 255, 0.84);
    font-size: clamp(16px, 1.25vw, 20px);
    line-height: 1.7;
  }
  .page-header__meta {
    display: flex;
    flex-wrap: wrap;
    gap: 10px 18px;
    margin-top: 26px;
    color: rgba(255, 255, 255, 0.84);
    font-size: 15px;
  }

  @media (max-width: 768px) {
    .page-header__card :global(.stars) { opacity: 0.22; }
  }
</style>
