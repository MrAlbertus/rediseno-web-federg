---
import type { CollectionEntry } from 'astro:content';
import { formatDate, isoDate } from '../lib/content';

interface Props {
  entry: CollectionEntry<'news'>;
  /** Visual variant of the top band, cycles through brand colours */
  tone?: number;
  headingLevel?: 'h2' | 'h3';
}

const { entry, tone = 0, headingLevel: Heading = 'h3' } = Astro.props;
const { title, date, excerpt, tags } = entry.data;
const tones = ['navy', 'blue', 'warm'];
---

<article class:list={['news-card', `news-card--${tones[tone % tones.length]}`]}>
  <div class="news-card__band" aria-hidden="true">
    <span class="news-card__tag">{tags[0] ?? 'News'}</span>
  </div>
  <div class="news-card__body">
    <time datetime={isoDate(date)}>{formatDate(date)}</time>
    <Heading class="news-card__title">
      <a href={`/news/${entry.id}`}>{title}</a>
    </Heading>
    <p>{excerpt}</p>
  </div>
</article>

<style>
  .news-card {
    position: relative;
    display: flex;
    flex-direction: column;
    height: 100%;
    overflow: hidden;
    border-radius: var(--radius-card);
    background: var(--surface);
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }
  .news-card:hover,
  .news-card:focus-within {
    transform: translateY(-6px);
    box-shadow: 0 22px 50px rgba(var(--navy-rgb), 0.14);
  }

  .news-card__band {
    position: relative;
    height: 120px;
    padding: 18px;
    display: flex;
    align-items: flex-start;
  }
  .news-card--navy .news-card__band {
    background: radial-gradient(80% 120% at 100% 100%, rgba(255, 100, 0, 0.5), transparent 60%), var(--navy);
  }
  .news-card--blue .news-card__band {
    background: radial-gradient(70% 120% at 0% 100%, rgba(255, 205, 5, 0.3), transparent 60%), var(--eu-blue);
  }
  .news-card--warm .news-card__band {
    background: linear-gradient(120deg, var(--orange) 0%, #ff8a3d 100%);
  }
  .news-card__tag {
    padding: 6px 12px;
    border-radius: 999px;
    background: #fff;
    color: var(--navy);
    font-size: 13px;
    font-weight: 600;
  }

  .news-card__body {
    display: flex;
    flex-direction: column;
    gap: 10px;
    padding: 24px 26px 30px;
  }
  time {
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .news-card__title {
    margin: 0;
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .news-card__title a {
    color: var(--ink);
    text-decoration: none;
  }
  /* The whole card is clickable, but only the title is a real link (one tab stop) */
  .news-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .news-card__title a:focus-visible { outline: none; box-shadow: none; }
  .news-card:has(a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--navy);
  }
  .news-card:hover .news-card__title a { text-decoration: underline 2px var(--accent); text-underline-offset: 5px; }
  p {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }
</style>
