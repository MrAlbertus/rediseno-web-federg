---
import InnerLayout from '../../layouts/InnerLayout.astro';
import { getMembers } from '../../lib/content';

const members = await getMembers();
const countries = new Set(members.map((m) => m.data.country)).size;
---

<InnerLayout
  title="Our members"
  eyebrow="About FEDERG"
  lead="Patient associations for rare and genetic kidney diseases from across Europe."
>
  <div class="container">
    <p class="notice" data-reveal>
      The association names below are invented samples for this training project.
    </p>

    <p class="summary" data-reveal>
      <strong>{members.length}</strong> associations · <strong>{countries}</strong> countries
    </p>

    <ul class="card-grid card-grid--3">
      {
        members.map((m, i) => (
          <li class="member" data-reveal style={`--rd:${i % 3}`}>
            <span class="member__country">{m.data.country}</span>
            <h2 class="member__name">{m.data.name}</h2>
            <p class="member__focus">{m.data.focus}</p>
          </li>
        ))
      }
    </ul>
  </div>
</InnerLayout>

<style>
  .summary {
    margin: 32px 0 24px;
    color: var(--muted);
    font-size: 18px;
  }
  .summary strong { color: var(--ink); font-size: 1.4em; }
  .member {
    padding: clamp(24px, 2.4vw, 32px);
    border-radius: var(--radius-card);
    background: var(--surface);
    border-top: 4px solid var(--accent);
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out);
  }
  .member:hover {
    transform: translateY(-4px);
    box-shadow: 0 18px 40px rgba(var(--navy-rgb), 0.1);
  }
  .member__country {
    color: var(--eu-blue);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .member__name {
    margin: 10px 0 6px;
    font-size: 1.25rem;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .member__focus { margin: 0; color: var(--muted); }
</style>
