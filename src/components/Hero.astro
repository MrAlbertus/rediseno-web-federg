---
import Nav from './Nav.astro';
import Stars from './Stars.astro';
import { HERO_MEDIA, HERO_COPY } from '../config/hero';
import { SOCIALS, DISCLAIMER } from '../config/site';

const { mp4, webm, poster, highlightPosition } = HERO_MEDIA;
const hasVideo = Boolean(mp4 || webm);

// With a poster, the highlighted word is filled with that image (like the template);
// without one it falls back to the brand gradient defined in global.css.
const heroStyle = [
  poster ? `--hl-img:url("${poster}")` : '',
  `--hl-pos:${highlightPosition}`,
].filter(Boolean).join(';');
---

<section class="hero" style={heroStyle} aria-labelledby="hero-title">
  <!-- DOM order matters: media first, left column second (see docs/hero-reference.md §3) -->
  <div class="hero__media anim" style="--d:0">
    {
      poster && (
        <img
          class="hero__video anim"
          style="--d:1"
          src={poster}
          alt=""
          fetchpriority="high"
          decoding="async"
        />
      )
    }
    {
      hasVideo && (
        <video
          class="hero__video anim"
          style="--d:1"
          muted
          loop
          playsinline
          preload="metadata"
          poster={poster || undefined}
          aria-hidden="true"
          data-hero-video
        >
          {webm && <source data-src={webm} type="video/webm" />}
          {mp4 && <source data-src={mp4} type="video/mp4" />}
        </video>
      )
    }
    {
      !poster && !hasVideo && (
        <div class="hero__video hero__placeholder anim" style="--d:1" aria-hidden="true">
          <Stars />
        </div>
      )
    }

    <div class="marker marker--one" aria-hidden="true">
      <span class="marker__line anim" style="--d:16"></span>
      <span class="marker__dot anim" style="--d:15"></span>
      <span class="marker__label anim" style="--d:17">{HERO_COPY.markers[0]}</span>
    </div>
    <div class="marker marker--two marker--right" aria-hidden="true">
      <span class="marker__line anim" style="--d:19"></span>
      <span class="marker__dot anim" style="--d:18"></span>
      <span class="marker__label anim" style="--d:20">{HERO_COPY.markers[1]}</span>
    </div>
  </div>

  <div class="hero__left">
    <Nav animate />

    <div class="hero__content" id="content" tabindex="-1">
      <h1 class="hero__title" id="hero-title">
        <span class="hero__line anim" style="--d:11">
          {HERO_COPY.lineOneBefore} <span class="hl">{HERO_COPY.highlight}</span>
        </span>
        <span class="hero__line anim" style="--d:12">{HERO_COPY.lineTwo}</span>
      </h1>

      <p class="hero__text anim" style="--d:13">{HERO_COPY.text}</p>

      <a class="cta" href={HERO_COPY.ctaHref}>
        <span class="cta__label anim" style="--d:14">{HERO_COPY.ctaLabel}</span>
        <span class="cta__icon anim" style="--d:15">
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d="M5 12h14M13 6l6 6-6 6"></path>
          </svg>
        </span>
      </a>

      <div class="socials socials--mobile">
        {
          SOCIALS.map((s, i) => (
            <a class="anim" style={`--d:${16 + i}`} href={s.href} aria-label={s.label}>
              <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
                <path d={s.path} />
              </svg>
            </a>
          ))
        }
      </div>

      <p class="hero__note anim" style="--d:16">{DISCLAIMER}</p>
    </div>
  </div>

  <!--
    Card social pill. It sits visually in the card's corner, but lives AFTER the left
    column in the DOM so keyboard users reach it after the headline and CTA, not before
    the logo (the media card comes first in the DOM for the z-index trick).
  -->
  <div class="socials socials--card anim" style="--d:21">
    {
      SOCIALS.map((s) => (
        <a href={s.href} aria-label={s.label}>
          <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false">
            <path d={s.path} />
          </svg>
        </a>
      ))
    }
  </div>
</section>

<style>
  /* ---------- 3. Layout shell ---------- */
  .hero {
    position: relative;
    height: 100vh;
    height: 100svh;
    min-height: 600px;
    width: 100%;
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 0.92fr);
    gap: clamp(16px, 2.4vw, 40px);
    padding: var(--pad);
    padding-left: max(var(--pad), env(safe-area-inset-left));
    padding-right: max(var(--pad), env(safe-area-inset-right));
    overflow: hidden;
  }

  /* No z-index here: .hero__left must never become a stacking context */
  .hero__left {
    position: relative;
    order: 1;
    display: flex;
    flex-direction: column;
    min-width: 0;
    padding-left: clamp(4px, 1.6vw, 28px);
  }

  /* ---------- 4b. Content ---------- */
  .hero__content {
    margin-top: auto;
    padding: clamp(24px, 4vh, 60px) 0;
    max-width: 820px;
  }
  /* Skip-link target: receives focus programmatically, no ring needed */
  .hero__content:focus { outline: none; box-shadow: none; }

  .hero__title {
    margin: 0;
    font-weight: 600;
    letter-spacing: -0.022em;
    line-height: 1.1;
    font-size: clamp(2.15rem, 3.85vw, 4.1rem);
  }
  .hero__line { display: block; }

  .hl {
    display: inline-block;
    color: #fff;
    padding: 0.06em 0.2em 0.14em;
    margin: 0 0.04em;
    border-radius: 16px;
    background-image: var(--hl-img, var(--hl-fill));
    background-size: cover;
    background-position: var(--hl-pos, 56% 14%);
    background-repeat: no-repeat;
    /* Orange underline bar: the brand accent without putting white text on orange */
    box-shadow: inset 0 -0.09em 0 var(--accent);
    -webkit-box-decoration-break: clone;
    box-decoration-break: clone;
  }

  .hero__text {
    margin: clamp(22px, 3.2vh, 42px) 0 0;
    max-width: 47ch;
    color: var(--muted);
    font-size: clamp(14px, 1.02vw, 17px);
    line-height: 1.95;
  }

  .cta {
    display: inline-flex;
    align-items: center;
    gap: clamp(14px, 1.5vw, 24px);
    margin-top: clamp(28px, 5vh, 66px);
    text-decoration: none;
    color: inherit;
    border-radius: 999px;
  }
  .cta__label {
    font-size: clamp(15px, 1.1vw, 19px);
    font-weight: 500;
  }
  .cta__icon {
    width: clamp(44px, 3.6vw, 58px);
    height: clamp(44px, 3.6vw, 58px);
    border-radius: 50%;
    border: 1.5px solid rgba(var(--navy-rgb), 0.55);
    display: grid;
    place-items: center;
    flex: 0 0 auto;
    transition: background 0.25s ease, color 0.25s ease, border-color 0.25s ease, transform 0.25s ease;
  }
  .cta__icon svg {
    width: 44%;
    height: 44%;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.8;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  /* Accent on hover: navy arrow on orange (5.3:1) */
  .cta:hover .cta__icon,
  .cta:focus-visible .cta__icon {
    background: var(--accent);
    border-color: var(--accent);
    color: var(--navy);
    transform: translateX(4px);
  }

  .hero__note {
    display: flex;
    align-items: center;
    gap: 8px;
    margin: clamp(18px, 3vh, 34px) 0 0;
    font-size: 12px;
    font-weight: 500;
    color: var(--muted);
  }
  .hero__note::before {
    content: '';
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    flex: 0 0 auto;
  }

  /* ---------- 5. Media card ---------- */
  .hero__media {
    position: relative;
    order: 2;
    isolation: isolate;
    border-radius: var(--radius-card);
    overflow: hidden;
    background: var(--navy);
    min-width: 0;
  }
  .hero__video {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  .hero__media::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, rgba(0, 0, 0, 0.12), rgba(0, 0, 0, 0) 38%);
    pointer-events: none;
  }

  /* Placeholder until a real video/poster is set in src/config/hero.ts */
  .hero__placeholder {
    background:
      radial-gradient(60% 45% at 92% 96%, rgba(255, 100, 0, 0.55), transparent 70%),
      radial-gradient(75% 65% at 8% 6%, rgba(35, 62, 144, 0.95), transparent 70%),
      linear-gradient(160deg, #27275c 0%, #1f1f3f 58%, #16162e 100%);
  }

  /* Callout markers */
  .marker {
    position: absolute;
    z-index: 3;
    --dot-r: 17px;
  }
  .marker--one { left: 56%; top: 26%; }
  .marker--two { left: 59%; top: 59%; }
  .marker__dot {
    position: absolute;
    left: calc(var(--dot-r) * -1);
    top: calc(var(--dot-r) * -1);
    width: calc(var(--dot-r) * 2);
    height: calc(var(--dot-r) * 2);
    border: 4px solid #fff;
    border-radius: 50%;
    box-shadow: 0 2px 12px rgba(0, 0, 0, 0.28);
  }
  .marker__line {
    position: absolute;
    left: 0;
    top: -1.5px;
    width: 60px;
    height: 3px;
    background: #fff;
    border-radius: 2px;
    transform-origin: 0 50%;
    transform: rotate(212deg);
    clip-path: inset(0 0 0 var(--dot-r));
  }
  .marker__label {
    position: absolute;
    right: 50px;
    bottom: 28px;
    white-space: nowrap;
    background: #fff;
    color: var(--ink);
    font-size: clamp(13px, 0.95vw, 16px);
    font-weight: 500;
    padding: 0.62em 1.05em;
    border-radius: 999px;
    box-shadow: 0 6px 20px rgba(0, 0, 0, 0.16);
  }
  .marker--right .marker__line { transform: rotate(-32deg); }
  .marker--right .marker__label { right: auto; left: 50px; }

  /* Social pill notched into the card's bottom-right corner (positioned against
     .hero, whose padding edge is exactly the card's corner) */
  .socials {
    position: absolute;
    right: max(var(--pad), env(safe-area-inset-right));
    bottom: var(--pad);
    z-index: 3;
    display: flex;
    align-items: center;
    gap: clamp(18px, 2.2vw, 38px);
    background: var(--bg);
    padding: clamp(14px, 1.5vw, 24px) clamp(20px, 2.2vw, 38px);
    border-top-left-radius: 36px;
    border-bottom-right-radius: var(--radius-card);
  }
  .socials a {
    color: var(--ink);
    display: grid;
    place-items: center;
    border-radius: 6px;
    transition: opacity 0.2s ease, transform 0.2s ease;
  }
  .socials a:hover {
    opacity: 0.65;
    transform: translateY(-2px);
  }
  .socials svg {
    width: clamp(20px, 1.5vw, 26px);
    height: clamp(20px, 1.5vw, 26px);
    fill: currentColor;
  }
  /* Must come after .socials so it wins: only shown in the phone layout */
  .socials--mobile { display: none; }

  /* ---------- 7. Entrance overrides ---------- */
  .hero__media.anim { animation-name: media-in; animation-duration: 1.05s; }
  .hero__video.anim { animation-name: video-in; animation-duration: 1.35s; }
  .marker__dot.anim { animation-name: pop-in; animation-duration: 0.62s; }
  .marker__label.anim { animation-duration: 0.7s; }
  .marker__line.anim { animation-name: draw-line; animation-duration: 0.55s; }
  .marker--right .marker__line.anim { animation-name: draw-line-right; }

  /* ---------- 8. Responsive ---------- */
  @media (max-width: 1180px) {
    .hero__text { line-height: 1.8; }
  }

  @media (max-width: 1024px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 0.78fr); }
    .marker--one { left: 46%; top: 24%; }
    .marker--two { left: 50%; top: 60%; }
    .marker__line { width: 44px; }
    .marker { --dot-r: 13px; }
    .marker__dot { border-width: 3px; }
    .marker__label { font-size: 12px; right: 36px; bottom: 22px; }
    .marker--right .marker__label { right: auto; left: 36px; }
  }

  @media (max-width: 900px) {
    .hero { grid-template-columns: minmax(0, 1fr) minmax(0, 0.62fr); }
    .hero__text { max-width: 42ch; }
    .marker--one { left: 40%; top: 22%; }
    .marker--two { left: 44%; top: 62%; }
    /* The narrow card cannot fit both pills side by side with the copy */
    .marker__label { font-size: 11px; }
  }

  /* Phone: the media becomes the full-bleed hero background */
  @media (max-width: 768px) {
    .hero {
      display: block;
      padding: 0;
      color: #fff;
    }
    .hero__media {
      position: absolute;
      inset: 0;
      border-radius: 0;
    }
    .hero__media::after {
      background: linear-gradient(
        180deg,
        rgba(var(--navy-rgb), 0.74) 0%,
        rgba(var(--navy-rgb), 0.5) 42%,
        rgba(var(--navy-rgb), 0.9) 100%
      );
    }
    .marker,
    .socials { display: none; }
    .hero__placeholder :global(.stars) { opacity: 0.3; }
    .hero__left {
      height: 100%;
      padding: var(--pad);
      padding-top: max(var(--pad), env(safe-area-inset-top));
      padding-bottom: max(var(--pad), env(safe-area-inset-bottom));
      color: #fff;
    }
    /* The logo keeps its original colours, so it sits on a white chip over the dark media */
    .hero__left :global(.brand) {
      background: #fff;
      padding: 7px 12px;
      border-radius: 12px;
    }
    .hero__left :global(.brand__logo) { height: 26px; }
    .hero__content { padding: clamp(20px, 3vh, 40px) 0; }
    .hero__title {
      font-size: clamp(2rem, 9.2vw, 3rem);
      line-height: 1.14;
    }
    .hl {
      border-radius: 12px;
      box-shadow: inset 0 -0.09em 0 var(--accent), 0 0 0 1px rgba(255, 255, 255, 0.16);
    }
    .hero__text {
      color: rgba(255, 255, 255, 0.84);
      max-width: 38ch;
      line-height: 1.75;
      font-size: 15px;
    }
    .cta { color: #fff; margin-top: 32px; }
    .cta__icon { border-color: rgba(255, 255, 255, 0.6); }
    .hero__note { color: rgba(255, 255, 255, 0.72); }
    .socials--mobile {
      display: flex;
      position: static;
      background: transparent;
      padding: 0;
      margin-top: 34px;
      gap: 26px;
      border-radius: 0;
      z-index: auto;
    }
    .socials--mobile a { color: #fff; }
    .socials--mobile svg { width: 22px; height: 22px; }
  }

  @media (max-width: 420px) {
    .hero__title { font-size: clamp(1.8rem, 8.6vw, 2.4rem); }
    .hero__text { font-size: 14px; line-height: 1.7; }
    .cta { margin-top: 26px; }
    .socials--mobile { margin-top: 26px; }
  }

  @media (max-width: 360px) {
    .hero__text { max-width: none; }
  }

  /* Short viewports of ANY width must never force a scrollbar */
  @media (max-height: 620px) {
    .hero { min-height: 0; }
  }

  @media (max-width: 1024px) and (orientation: landscape) and (max-height: 540px) {
    .hero__content { padding: 10px 0; margin-top: auto; }
    .hero__title { font-size: clamp(1.5rem, 6.2vh, 2.1rem); line-height: 1.12; }
    .hero__text { font-size: 13px; line-height: 1.6; max-width: 56ch; margin-top: 12px; }
    .cta { margin-top: 16px; gap: 12px; }
    .cta__icon { width: 38px; height: 38px; }
    .cta__label { font-size: 14px; }
    .socials--mobile { margin-top: 16px; gap: 22px; }
    .socials--mobile svg { width: 18px; height: 18px; }
    .hero__note { margin-top: 12px; font-size: 11px; }
  }
</style>

<script>
  // Load the video only where it pays off: wide screens, motion allowed.
  // Phones and reduced-motion users keep the lightweight poster.
  const video = document.querySelector<HTMLVideoElement>('[data-hero-video]');
  const wantsVideo = window.matchMedia(
    '(min-width: 769px) and (prefers-reduced-motion: no-preference)'
  ).matches;

  if (video && wantsVideo) {
    video.querySelectorAll<HTMLSourceElement>('source[data-src]').forEach((source) => {
      source.src = source.dataset.src ?? '';
    });
    video.load();
    video.play().catch(() => {
      /* Autoplay refused: the poster stays visible, which is fine */
    });
  }
</script>
