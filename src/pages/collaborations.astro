---
import { render } from 'astro:content';
import InnerLayout from '../layouts/InnerLayout.astro';
import { getCollaborations } from '../lib/content';

const items = await Promise.all(
  (await getCollaborations()).map(async (entry) => ({ entry, ...(await render(entry)) }))
);
---

<InnerLayout
  title="Collaborations"
  eyebrow="Working together"
  lead="No federation works alone. These are some of the European organisations we collaborate with."
>
  <div class="container">
    <ul class="card-grid">
      {
        items.map(({ entry, Content }, i) => (
          <li class="collab" data-reveal style={`--rd:${i % 2}`}>
            <span class="collab__badge" aria-hidden="true">{entry.data.acronym ?? entry.data.name.charAt(0)}</span>
            <h2 class="collab__name">{entry.data.name}</h2>
            <p class="collab__summary">{entry.data.summary}</p>
            <div class="prose collab__body">
              <Content />
            </div>
            {entry.data.website && (
              <a class="collab__link" href={entry.data.website} rel="noopener" target="_blank">
                Visit website<span class="visually-hidden"> of {entry.data.name} (opens in a new tab)</span>
                <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M7 17 17 7M9 7h8v8" /></svg>
              </a>
            )}
          </li>
        ))
      }
    </ul>
  </div>
</InnerLayout>

<style>
  .collab {
    display: flex;
    flex-direction: column;
    gap: 12px;
    padding: clamp(26px, 3vw, 40px);
    border-radius: var(--radius-card);
    background: var(--surface);
  }
  .collab__badge {
    align-self: flex-start;
    padding: 10px 16px;
    border-radius: 14px;
    background: var(--navy);
    color: #fff;
    font-weight: 700;
    letter-spacing: 0.04em;
    box-shadow: inset 0 -3px 0 var(--accent);
  }
  .collab__name {
    margin: 10px 0 0;
    font-size: clamp(1.25rem, 1.8vw, 1.55rem);
    font-weight: 600;
    letter-spacing: -0.015em;
    line-height: 1.25;
  }
  .collab__summary { margin: 0; color: var(--ink); font-weight: 500; line-height: 1.6; }
  .collab__body { font-size: 16px; }
  .collab__link {
    display: inline-flex;
    align-items: center;
    gap: 8px;
    margin-top: auto;
    color: var(--eu-blue);
    font-weight: 600;
    text-decoration: underline 1.5px var(--accent);
    text-underline-offset: 5px;
  }
  .collab__link svg {
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
</style>
