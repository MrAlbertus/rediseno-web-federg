---
import BaseLayout from '../layouts/BaseLayout.astro';
import Hero from '../components/Hero.astro';
import SectionHead from '../components/SectionHead.astro';
import Pillars from '../components/Pillars.astro';
import NewsCard from '../components/NewsCard.astro';
import EventList from '../components/EventList.astro';
import ArrowLink from '../components/ArrowLink.astro';
import Stars from '../components/Stars.astro';
import { getNews, getEvents, getStories, getMembers } from '../lib/content';

const news = (await getNews()).slice(0, 3);
const { upcoming } = await getEvents();
const events = upcoming.slice(0, 3);
const [story] = await getStories();
const members = await getMembers();
---

<BaseLayout title="FEDERG – Uniting patients with rare kidney diseases (training project)">
  <main>
    <Hero />

    <!-- Who we are -->
    <section class="section" aria-labelledby="about-title">
      <div class="container">
        <div class="about">
          <div data-reveal>
            <p class="eyebrow">Who we are</p>
            <h2 class="h2" id="about-title">A shared voice for rare kidney disease patients across Europe</h2>
          </div>
          <div class="about__text" data-reveal style="--rd:1">
            <p class="lead">
              FEDERG is the non-profit federation of European associations of patients affected by
              rare and/or genetic kidney diseases.
            </p>
            <p class="lead">
              Our mission is to improve the health and quality of life of everyone affected, through
              advocacy, representation, engagement and collaboration.
            </p>
            <ArrowLink href="/about" label="More about FEDERG" />
          </div>
        </div>
        <Pillars />
      </div>
    </section>

    <!-- Members -->
    <section class="members-band" aria-labelledby="members-title">
      <div class="container members">
        <Stars size="clamp(360px, 48vw, 720px)" x="96%" y="20%" opacity={0.3} />
        <div class="members__inner">
          <SectionHead
            id="members-title"
            eyebrow="Member associations"
            title="Patient associations from across Europe, working as one"
            intro="Each member association brings the experience of its own patients and families. Together they shape FEDERG's priorities."
            light
          />
          <ul class="members__list">
            {
              members.map((m, i) => (
                <li class="member" data-reveal style={`--rd:${i % 3}`}>
                  <span class="member__country">{m.data.country}</span>
                  <span class="member__name">{m.data.name}</span>
                  <span class="member__focus">{m.data.focus}</span>
                </li>
              ))
            }
          </ul>
          <div class="members__foot" data-reveal>
            <ArrowLink href="/about/members" label="Meet all our members" />
            <p>Sample association names for this training project.</p>
          </div>
        </div>
      </div>
    </section>

    <!-- Latest news -->
    <section class="section" aria-labelledby="news-title">
      <div class="container">
        <SectionHead
          id="news-title"
          eyebrow="News"
          title="Latest news"
          link={{ href: '/news', label: 'All news & events' }}
        />
        <ul class="news-grid">
          {
            news.map((entry, i) => (
              <li data-reveal style={`--rd:${i}`}>
                <NewsCard entry={entry} tone={i} />
              </li>
            ))
          }
        </ul>
      </div>
    </section>

    <!-- Upcoming events -->
    <section class="section section--flush-top" aria-labelledby="events-title">
      <div class="container">
        <SectionHead
          id="events-title"
          eyebrow="Events"
          title="Upcoming events"
          link={{ href: '/events', label: 'See all events' }}
        />
        <EventList events={events} />
      </div>
    </section>

    <!-- Featured patient story -->
    {
      story && (
        <section class="section section--flush-top" aria-labelledby="story-title">
          <div class="container story">
            <div class="story__visual" data-reveal aria-hidden="true">
              <Stars size="130%" x="50%" y="50%" opacity={0.35} />
              <span class="story__initial">{story.data.name.charAt(0)}</span>
              <span class="story__badge">Fictional story</span>
            </div>
            <div class="story__text" data-reveal style="--rd:1">
              <p class="eyebrow">Patient stories</p>
              <h2 class="visually-hidden" id="story-title">Featured patient story</h2>
              <blockquote>
                <p>“{story.data.quote}”</p>
              </blockquote>
              <p class="story__who">
                <strong>{story.data.name}</strong>, {story.data.age} · {story.data.condition} · {story.data.country}
              </p>
              <div class="story__links">
                <ArrowLink href={`/patient-stories/${story.id}`} label={`Read ${story.data.name}’s story`} />
                <a class="story__all" href="/patient-stories">All patient stories</a>
              </div>
            </div>
          </div>
        </section>
      )
    }

    <!-- Contact CTA -->
    <section class="section section--flush-top section--last" aria-labelledby="cta-title">
      <div class="container">
        <div class="cta-band" data-reveal>
          <div>
            <h2 class="h2" id="cta-title">Let’s make rare kidney diseases less lonely.</h2>
            <p>
              Are you a patient association, a researcher or a clinician? We would love to hear from
              you.
            </p>
          </div>
          <a class="btn" href="/contact">
            Get in touch
            <svg viewBox="0 0 24 24" aria-hidden="true" focusable="false"><path d="M5 12h14M13 6l6 6-6 6"></path></svg>
          </a>
        </div>
      </div>
    </section>
  </main>
</BaseLayout>

<style>
  .section--flush-top { padding-top: 0; }
  .section--last { padding-bottom: clamp(24px, 3vw, 40px); }

  /* Who we are */
  .about {
    display: grid;
    gap: 28px 64px;
    margin-bottom: clamp(40px, 5vw, 72px);
  }
  @media (min-width: 960px) {
    .about { grid-template-columns: 1.1fr 1fr; align-items: end; }
  }
  .about__text {
    display: grid;
    gap: 20px;
    justify-items: start;
  }

  /* Members band */
  .members {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    padding: clamp(40px, 6vw, 88px) clamp(24px, 5vw, 72px);
    border-radius: var(--radius-card);
    background:
      radial-gradient(70% 90% at 0% 100%, rgba(35, 62, 144, 0.9), transparent 70%),
      var(--navy);
    color: #fff;
  }
  .members__inner { position: relative; }
  .members__list {
    display: grid;
    gap: 14px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 640px) {
    .members__list { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1024px) {
    .members__list { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }
  .member {
    display: flex;
    flex-direction: column;
    gap: 6px;
    padding: 22px 24px;
    border-radius: 20px;
    background: rgba(255, 255, 255, 0.07);
    border: 1px solid rgba(255, 255, 255, 0.12);
    -webkit-backdrop-filter: blur(6px);
    backdrop-filter: blur(6px);
    transition: background 0.3s ease, border-color 0.3s ease;
  }
  .member:hover {
    background: rgba(255, 255, 255, 0.12);
    border-color: rgba(255, 100, 0, 0.6);
  }
  .member__country {
    color: var(--accent);
    font-size: 13px;
    font-weight: 600;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  .member__name { font-size: 1.1rem; font-weight: 600; }
  .member__focus { color: rgba(255, 255, 255, 0.72); font-size: 15px; }
  .members__foot {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 16px 32px;
    margin-top: clamp(28px, 3vw, 44px);
  }
  .members__foot p { margin: 0; color: rgba(255, 255, 255, 0.6); font-size: 14px; }

  /* News */
  .news-grid {
    display: grid;
    gap: 20px;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  @media (min-width: 720px) {
    .news-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  @media (min-width: 1100px) {
    .news-grid { grid-template-columns: repeat(3, minmax(0, 1fr)); }
  }

  /* Featured story */
  .story {
    display: grid;
    gap: clamp(28px, 5vw, 72px);
    align-items: center;
  }
  @media (min-width: 900px) {
    .story { grid-template-columns: minmax(0, 0.8fr) minmax(0, 1fr); }
  }
  .story__visual {
    position: relative;
    overflow: hidden;
    isolation: isolate;
    display: grid;
    place-items: center;
    aspect-ratio: 4 / 3.4;
    border-radius: var(--radius-card);
    background:
      radial-gradient(60% 60% at 80% 90%, rgba(255, 100, 0, 0.5), transparent 70%),
      linear-gradient(160deg, var(--eu-blue), var(--navy));
  }
  .story__initial {
    position: relative;
    display: grid;
    place-items: center;
    width: clamp(110px, 14vw, 170px);
    aspect-ratio: 1;
    border-radius: 50%;
    background: #fff;
    color: var(--navy);
    font-size: clamp(3rem, 6vw, 4.6rem);
    font-weight: 700;
    box-shadow: inset 0 -8px 0 var(--accent), 0 20px 50px rgba(0, 0, 0, 0.3);
  }
  .story__badge {
    position: absolute;
    left: 20px;
    bottom: 20px;
    padding: 8px 14px;
    border-radius: 999px;
    background: #fff;
    color: var(--navy);
    font-size: 13px;
    font-weight: 600;
  }
  .story blockquote { margin: 0; }
  .story blockquote p {
    margin: 0;
    font-size: clamp(1.5rem, 2.6vw, 2.3rem);
    font-weight: 600;
    letter-spacing: -0.02em;
    line-height: 1.25;
    text-wrap: balance;
  }
  .story__who {
    margin: 22px 0 0;
    color: var(--muted);
  }
  .story__who strong { color: var(--ink); }
  .story__links {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 16px 32px;
    margin-top: 32px;
  }
  .story__all {
    color: var(--ink);
    font-weight: 500;
    text-decoration: underline 1.5px var(--accent);
    text-underline-offset: 5px;
  }

  /* Contact CTA: navy text on orange = 5.3:1 (white on orange would fail AA) */
  .cta-band {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 28px 48px;
    padding: clamp(36px, 5vw, 72px) clamp(24px, 5vw, 72px);
    border-radius: var(--radius-card);
    background: var(--orange);
    color: var(--navy);
  }
  .cta-band > div { max-width: 680px; }
  .cta-band p {
    margin: 16px 0 0;
    font-size: clamp(16px, 1.2vw, 19px);
    line-height: 1.6;
    font-weight: 500;
  }
  .cta-band .btn:hover { background: #fff; color: var(--navy); }
</style>
