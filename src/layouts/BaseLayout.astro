---
import '@fontsource-variable/plus-jakarta-sans';
import '../styles/global.css';
import NavSheet from '../components/NavSheet.astro';
import Footer from '../components/Footer.astro';

interface Props {
  title: string;
  description?: string;
}

const {
  title,
  description = 'Training project redesign of the FEDERG website – not the official FEDERG website.',
} = Astro.props;

// Training project: pages are noindex by default so search engines never list them as
// the real FEDERG site. Build with INDEXABLE=true only to measure the "real" SEO score.
const indexable = process.env.INDEXABLE === 'true';
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1, viewport-fit=cover" />
    <title>{title}</title>
    <meta name="description" content={description} />
    {!indexable && <meta name="robots" content="noindex, nofollow" />}
    <meta name="theme-color" content="#1f1f3f" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <!-- Tells the CSS that JS is running, so scroll-reveal can hide content safely -->
    <script is:inline>document.documentElement.classList.add('js');</script>
    <slot name="head" />
  </head>
  <body>
    <a class="skip-link" href="#content">Skip to content</a>
    <slot />
    <Footer />
    <NavSheet />

    <script>
      // Scroll reveal: elements with [data-reveal] fade up once when they enter the viewport.
      const targets = document.querySelectorAll<HTMLElement>('[data-reveal]');
      if ('IntersectionObserver' in window) {
        const io = new IntersectionObserver(
          (entries) => {
            for (const entry of entries) {
              if (!entry.isIntersecting) continue;
              entry.target.classList.add('is-visible');
              io.unobserve(entry.target);
            }
          },
          { rootMargin: '0px 0px -8% 0px', threshold: 0.12 }
        );
        targets.forEach((el) => io.observe(el));
      } else {
        targets.forEach((el) => el.classList.add('is-visible'));
      }
    </script>
  </body>
</html>
