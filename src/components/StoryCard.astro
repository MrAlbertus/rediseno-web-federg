---
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'stories'>;
  headingLevel?: 'h2' | 'h3';
}

const { entry, headingLevel: Heading = 'h3' } = Astro.props;
const { title, name, country, condition, excerpt } = entry.data;
---

<article class="story-card">
  <div class="story-card__avatar" aria-hidden="true">{name.charAt(0)}</div>
  <p class="story-card__who">{name} · {country}</p>
  <Heading class="story-card__title">
    <a href={`/patient-stories/${entry.id}`}>{title}</a>
  </Heading>
  <p class="story-card__excerpt">{excerpt}</p>
  <p class="story-card__condition"><span class="tag">{condition}</span></p>
</article>

<style>
  .story-card {
    position: relative;
    display: flex;
    flex-direction: column;
    gap: 12px;
    height: 100%;
    padding: clamp(24px, 2.6vw, 34px);
    border-radius: var(--radius-card);
    background: #fff;
    border: 1px solid #e6e6ef;
    transition: transform 0.45s var(--ease-out), box-shadow 0.45s var(--ease-out), border-color 0.3s ease;
  }
  .story-card:hover,
  .story-card:focus-within {
    transform: translateY(-6px);
    border-color: transparent;
    box-shadow: 0 22px 50px rgba(var(--navy-rgb), 0.14);
  }
  .story-card__avatar {
    display: grid;
    place-items: center;
    width: 56px;
    height: 56px;
    margin-bottom: 6px;
    border-radius: 50%;
    background: linear-gradient(135deg, var(--eu-blue), var(--navy));
    box-shadow: inset 0 -4px 0 var(--accent);
    color: #fff;
    font-size: 22px;
    font-weight: 700;
  }
  .story-card__who {
    margin: 0;
    color: var(--muted);
    font-size: 14px;
    font-weight: 500;
  }
  .story-card__title {
    margin: 0;
    font-size: clamp(1.15rem, 1.5vw, 1.35rem);
    font-weight: 600;
    letter-spacing: -0.012em;
    line-height: 1.3;
  }
  .story-card__title a { color: var(--ink); text-decoration: none; }
  .story-card__title a::after {
    content: '';
    position: absolute;
    inset: 0;
    border-radius: inherit;
  }
  .story-card__title a:focus-visible { outline: none; box-shadow: none; }
  .story-card:has(a:focus-visible) {
    outline: 3px solid var(--accent);
    outline-offset: 2px;
    box-shadow: 0 0 0 2px var(--navy);
  }
  .story-card__excerpt {
    margin: 0;
    color: var(--muted);
    line-height: 1.65;
  }
  .story-card__condition { margin: auto 0 0; padding-top: 8px; }
</style>
